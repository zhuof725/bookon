    {"name": "synthetic_whitespace_split", "res": "a b c", "regs": ["(\\S+)"]},
    {"name": "synthetic_overlap_candidate", "res": "aaa", "regs": ["a"]},
    {"name": "synthetic_case_insensitive", "res": "FOO foo Foo", "regs": ["(?i)(foo)"]},
