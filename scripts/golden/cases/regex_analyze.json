    {"name": "synthetic_multiline", "res": "line1\nline2\nline3", "regs": ["(?m)^line(\\d)$"]},
    {"name": "synthetic_three_level", "res": "AAbbCCddEE", "regs": ["[A-Z]+..", "[A-Z]+", "([A-Z])([A-Z])"]},
    {"name": "synthetic_unicode", "res": "价格：100元 价格：200元", "regs": ["价格：(\\d+)元"]},
    {"name": "synthetic_nested_groups", "res": "abc", "regs": ["((a)(b)(c))"]},
