    {"name": "synthetic_multi_matches", "res": "a1 a2 a3", "regs": ["a(\\d)"]},
    {"name": "synthetic_two_groups", "res": "key=val", "regs": ["(\\w+)=(\\w+)"]},
    {"name": "synthetic_group0_only", "res": "hello world", "regs": ["\\w+"]},
    {"name": "synthetic_two_level", "res": "<li>A</li><li>B</li>", "regs": ["<li>.*?</li>", "<li>(.*?)</li>"]},
    {"name": "synthetic_three_groups", "res": "2024-01-15", "regs": ["(\\d{4})-(\\d{2})-(\\d{2})"]},
    {"name": "synthetic_optional_group", "res": "abc", "regs": ["a(x)?bc"]},
    {"name": "synthetic_repeated_rows", "res": "row1|row2|row3", "regs": ["row(\\d)"]},
    {"name": "synthetic_cn_chapters", "res": "第1章 第2章 第3章", "regs": ["第(\\d)章"]},
    {"name": "synthetic_nested_level2", "res": "x[1]y[2]z[3]", "regs": ["\\[\\d\\]", "\\[(\\d)\\]"]},
    {"name": "synthetic_empty_matches", "res": "abc", "regs": ["x*"]},
    {"name": "synthetic_full_match_no_group", "res": "single", "regs": ["single"]},
    {"name": "synthetic_alternation", "res": "cat dog cat", "regs": ["(cat|dog)"]},
