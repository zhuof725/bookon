<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.legado.golden</groupId>
  <artifactId>golden-generator</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 与 legado 锁定的 jsoup 版本一致 -->
    <jsoup.version>1.16.2</jsoup.version>
  </properties>

  <!-- 强制 jsoup 版本为 1.16.2（与 legado app/build.gradle.kts 一致，即使间接依赖引入其它版本也统一收敛）。 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jsoup</groupId>
        <artifactId>jsoup</artifactId>
        <version>${jsoup.version}</version>
      </dependency>
      <!-- commons-text 1.13.1 需要 commons-lang3 >= 3.18（NumericEntityEscaper 用到
           Range.of(Comparable,Comparable)）；JsoupXpath/jsoup 间接引入的旧版 lang3 会导致
           运行期 NoSuchMethodError，这里强制收敛到 3.18.0。 -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.18.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- 与 legado gradle/libs.versions.toml rhino=1.8.1 一致；真实 JS 求值/返回值拆箱对照。 -->
      <groupId>org.mozilla</groupId>
      <artifactId>rhino</artifactId>
      <version>1.8.1</version>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
    </dependency>
    <dependency>
      <!-- legado 用的 XPath 引擎：JsoupXpath 2.5.3（内部依赖 jsoup，已用上面的 dependencyManagement 收敛版本） -->
      <groupId>cn.wanghaomiao</groupId>
      <artifactId>JsoupXpath</artifactId>
      <version>2.5.3</version>
    </dependency>
    <dependency>
      <!-- gson 升到 2.13.2，与 legado gradle/libs.versions.toml 一致 -->
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.13.2</version>
    </dependency>
    <dependency>
      <!-- Jayway JsonPath 2.10.0，与 legado toml jsonPath=2.10.0 一致（第 2 步 AnalyzeByJSonPath 对照用真实库） -->
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>2.10.0</version>
    </dependency>
    <dependency>
      <!-- commons-text 1.13.1，与 legado toml commonsText=1.13.1 一致（unescapeHtml4 对照用真实库） -->
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.13.1</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>golden-generator</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- 多依赖（json-path / json-smart / commons-text）会各自带 META-INF/services，
                   用 ServicesResourceTransformer 合并避免 fat jar 里服务声明相互覆盖。 -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>golden.Main</mainClass>
                </transformer>
              </transformers>
              <!-- 去掉依赖 jar 自带的签名文件，否则 fat jar 启动会报 SecurityException。 -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
