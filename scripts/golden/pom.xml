<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.legado.golden</groupId>
  <artifactId>golden-generator</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <repositories>
    <repository>
      <!-- quick-transfer-core 0.2.17 发布在 JitPack（com.github.liuyueyi.quick-chinese-transfer） -->
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 与 legado 锁定的 jsoup 版本一致 -->
    <jsoup.version>1.16.2</jsoup.version>
    <!-- 第 6 步 6B：与 legado gradle/libs.versions.toml 的 okhttp=5.3.2 一致。
         用于 HttpUrl 规范化 golden（真实 OkHttp 的 HttpUrl.parse/toString）。 -->
    <okhttp.version>5.3.2</okhttp.version>
  </properties>

  <!-- 强制 jsoup 版本为 1.16.2（与 legado app/build.gradle.kts 一致，即使间接依赖引入其它版本也统一收敛）。 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jsoup</groupId>
        <artifactId>jsoup</artifactId>
        <version>${jsoup.version}</version>
      </dependency>
      <!-- commons-text 1.13.1 需要 commons-lang3 >= 3.18（NumericEntityEscaper 用到
           Range.of(Comparable,Comparable)）；JsoupXpath/jsoup 间接引入的旧版 lang3 会导致
           运行期 NoSuchMethodError，这里强制收敛到 3.18.0。 -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>3.18.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- 与 legado gradle/libs.versions.toml rhino=1.8.1 一致；真实 JS 求值/返回值拆箱对照。 -->
      <groupId>org.mozilla</groupId>
      <artifactId>rhino</artifactId>
      <version>1.8.1</version>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
    </dependency>
    <dependency>
      <!-- legado 用的 XPath 引擎：JsoupXpath 2.5.3（内部依赖 jsoup，已用上面的 dependencyManagement 收敛版本） -->
      <groupId>cn.wanghaomiao</groupId>
      <artifactId>JsoupXpath</artifactId>
      <version>2.5.3</version>
    </dependency>
    <dependency>
      <!-- gson 升到 2.13.2，与 legado gradle/libs.versions.toml 一致 -->
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.13.2</version>
    </dependency>
    <dependency>
      <!-- Jayway JsonPath 2.10.0，与 legado toml jsonPath=2.10.0 一致（第 2 步 AnalyzeByJSonPath 对照用真实库） -->
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>2.10.0</version>
    </dependency>
    <dependency>
      <!-- commons-text 1.13.1，与 legado toml commonsText=1.13.1 一致（unescapeHtml4 对照用真实库） -->
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.13.1</version>
    </dependency>
    <dependency>
      <!-- 第 6 步 6B：真实 OkHttp 5.3.2（URL 规范化对照）。OkHttp 5.x 是 KMP 模块，
           Maven 侧需要 JVM 变体 okhttp-jvm。 -->
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
      <version>${okhttp.version}</version>
    </dependency>
    <dependency>
      <!-- Step 5：hutool 5.8.22，与 legado toml hutool=5.8.22 一致（md5/base64/hex 对照用真实库） -->
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-crypto</artifactId>
      <version>5.8.22</version>
    </dependency>
    <dependency>
      <!-- Step 5：hutool-core 提供 Base64/HexUtil -->
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-core</artifactId>
      <version>5.8.22</version>
    </dependency>
    <dependency>
      <!-- Step 5：quick-chinese-transfer 0.2.17，与 legado toml quickChineseTransfer=0.2.17 一致（t2s/s2t 对照） -->
      <groupId>com.github.liuyueyi.quick-chinese-transfer</groupId>
      <artifactId>quick-transfer-core</artifactId>
      <version>0.2.17</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>golden-generator</finalName>
    <plugins>
      <!-- 第 6 步 6B：把 scripts/golden/icu4j-src（legado icu4j 检测器的 JVM 适配副本）加入编译源码目录。
           只增加源码目录，不触碰任何既有配置。 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>add-icu4j-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>icu4j-src</source>
              </sources>
            </configuration>
          </execution>
          <!-- 编译修复：legado icu4j 源码引用的 Android/androidx 符号由 stubs/ 里的最小桩提供。
               只新增这一个源码目录，不触碰其它配置。 -->
          <execution>
            <id>add-stubs-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>stubs</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- 多依赖（json-path / json-smart / commons-text）会各自带 META-INF/services，
                   用 ServicesResourceTransformer 合并避免 fat jar 里服务声明相互覆盖。 -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>golden.Main</mainClass>
                </transformer>
              </transformers>
              <!-- 去掉依赖 jar 自带的签名文件，否则 fat jar 启动会报 SecurityException。 -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
